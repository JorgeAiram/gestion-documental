{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Iniciar Plataforma Documental (FastAPI)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "backend.main:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8000",
                "--reload"
            ],
            "jinja": true,
            "justMyCode": false
        },
        {
            "name": "Ejecutar Pruebas de Verificación (RF-01 a RF-21)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/tests/run_tests.py",
            "console": "integratedTerminal"
        }
    ]
}
